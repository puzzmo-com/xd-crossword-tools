{
  "name": "xd-crossword-migrator",
  "version": "15.0.0-beta.6",
  "description": "Rewrites older xd crossword files (v3, and Puzzmo's pre-v4 xd) in xd v4 syntax",
  "main": "dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts --dts --format esm,cjs",
    "dev": "tsup src/index.ts --dts --format esm,cjs --watch",
    "type-check": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/puzzmo-com/xd-crossword-tools.git"
  },
  "homepage": "https://xd-crossword-tools.com/",
  "bugs": {
    "url": "https://github.com/puzzmo-com/xd-crossword-tools/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "tsup": "^8.1.0",
    "xd-crossword-tools-parser": "workspace:*"
  }
}
